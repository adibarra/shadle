{
  // oxc: oxlint diagnostics and oxfmt formatting
  "oxc.enable": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "prettier.enable": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never"
  },
  // set folder icons
  "material-icon-theme.folders.associations": {
    "logger": "interceptor",
    "migrations": "pipe",
    "operations": "tools"
  },
  // spellcheck dictionary
  "cSpell.words": [
    "adibarra",
    "adsbygoogle",
    "buildx",
    "bunfig",
    "citext",
    "datepicker",
    "demi",
    "esbuild",
    "iconify",
    "manten",
    "nprogress",
    "onnotice",
    "ossp",
    "pino",
    "plpgsql",
    "postbuild",
    "prexit",
    "regclass",
    "shadle",
    "taze",
    "unhead",
    "unocss",
    "unplugin",
    "upserts",
    "vite",
    "vuepic",
    "vueuse",
    "wordle"
  ]
}
