{
  "name": "@shadle/server",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "clean:all": "git clean -fdX",
    "dev": "NODE_ENV=dev bun --watch src/index.ts",
    "preview": "NODE_ENV=dev bun src/index.ts",
    "start": "NODE_ENV=prod bun src/index.ts",
    "test": "NODE_ENV=test bun test --preload ./tests/setup.ts ./tests"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/compress": "^8.3.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@shadle/config": "workspace:*",
    "@shadle/database": "workspace:*",
    "@shadle/logger": "workspace:*",
    "@shadle/types": "workspace:*",
    "fastify": "^5.6.2",
    "node-cron": "^4.2.1",
    "prexit": "^2.3.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}
