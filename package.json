{
  "name": "shadle",
  "version": "0.0.0",
  "private": true,
  "description": "A Wordle-style game for colors.",
  "contributors": [
    "adibarra <github@adibarra.com> (https://adibarra.com)"
  ],
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @shadle/client build",
    "check": "bun run --filter '*' check",
    "clean": "bun run --filter '*' clean",
    "clean:all": "[ -f .env ] && mv .env .env.backup; bun run --filter '*' clean:all && git clean -fdX; [ -f .env.backup ] && mv .env.backup .env",
    "dev": "bun run --filter '*' dev",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "COMMIT_HASH=$(git rev-parse HEAD) bun run --filter '*' preview",
    "start": "bun run --filter @shadle/server start",
    "taze": "taze -r -I",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "taze": "^19.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.3"
}
